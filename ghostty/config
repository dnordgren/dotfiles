# Shell
command = /opt/homebrew/bin/bash
term = xterm-256color

# Window
macos-titlebar-style = native
copy-on-select = clipboard
macos-option-as-alt = left

# Font
font-family = Berkeley Mono SemiCondensed
font-size = 15

# Theme
theme = Dark Jungle
window-theme = dark

# App Icon
# fav: glass, holographic, retro
macos-icon = retro
